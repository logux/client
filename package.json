{
  "name": "@logux/client",
  "version": "0.23.2",
  "description": "Logux base components to build web client",
  "keywords": [
    "client",
    "cross-tab",
    "indexeddb",
    "logux",
    "websocket"
  ],
  "homepage": "https://logux.org/",
  "license": "MIT",
  "author": "Andrey Sitnik <andrey@sitnik.es>",
  "repository": "logux/client",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ai"
    }
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": "./index.js",
    "./db": "./db.js",
    "./vue": "./vue/index.js",
    "./react": "./react/index.js",
    "./preact": "./preact/index.js",
    "./package.json": "./package.json",
    "./badge/styles": "./badge/styles/index.js"
  },
  "scripts": {
    "clean": "rm -Rf coverage/ test/demo/dist/",
    "test:lint": "oxlint",
    "test:size": "size-limit",
    "test:types": "check-dts",
    "test:build": "pnpm build && rm -Rf test/demo/dist/",
    "test:coverage": "vitest run --coverage",
    "test": "pnpm run clean && pnpm run /^test:/",
    "build": "vite build test/demo/ -m production --base /client/",
    "start": "vite test/demo/ --open"
  },
  "dependencies": {
    "@logux/actions": "github:logux/actions#next",
    "@logux/core": "github:logux/core#next",
    "nanoevents": "^10.0.0",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@logux/oxc-configs": "^1.1.0",
    "@nanostores/preact": "^1.1.0",
    "@nanostores/react": "^1.1.0",
    "@nanostores/sql": "^0.4.2",
    "@nanostores/vue": "^1.1.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/compiler-sfc": "^3.5.41",
    "check-dts": "^2.0.1",
    "eslint-plugin-prefer-let": "^4.2.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "multiocular": "^0.8.4",
    "nanodelay": "^2.0.2",
    "nanospy": "^2.0.2",
    "nanostores": "^1.5.1",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.26",
    "preact": "^10.29.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^13.0.3",
    "svgo": "^4.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "@nanostores/preact": ">=0.0.0",
    "@nanostores/react": ">=0.0.0",
    "@nanostores/sql": ">=0.4.0",
    "@nanostores/vue": ">=0.0.0",
    "nanostores": "^0.9.0 || ^0.10.0 || ^0.11.0 || ^1.0.0",
    "preact": ">=10.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=16.8.0",
    "vue": ">=3.3.2"
  },
  "peerDependenciesMeta": {
    "@nanostores/preact": {
      "optional": true
    },
    "@nanostores/react": {
      "optional": true
    },
    "@nanostores/sql": {
      "optional": true
    },
    "@nanostores/vue": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "CrossTabClient",
      "path": "./cross-tab-client/index.js",
      "import": "{ CrossTabClient }",
      "limit": "8.5 KB"
    },
    {
      "name": "Helpers",
      "import": {
        "./index.js": "{ attention, confirm, favicon, status, log, badge, badgeEn }"
      },
      "limit": "3 KB"
    },
    {
      "name": "Reducer",
      "import": {
        "./index.js": "{ createReducer }"
      },
      "limit": "1 KB"
    },
    {
      "name": "DB",
      "import": {
        "./create-crdt-table/index.js": "{ createCrdtDatabase }"
      },
      "limit": "3.7 KB"
    },
    {
      "name": "Log Store",
      "import": {
        "./sql-log-store/index.js": "{ SqlLogStore }"
      },
      "limit": "2.5 KB"
    },
    {
      "name": "React",
      "import": {
        "./index.js": "{ CrossTabClient, syncMapTemplate, changeSyncMap }",
        "./react/index.js": "{ ClientContext, useSync, ChannelErrors, useFilter, useAuth }"
      },
      "limit": "12 KB"
    },
    {
      "name": "Vue",
      "import": {
        "./index.js": "{ CrossTabClient, syncMapTemplate, changeSyncMap }",
        "./vue/index.js": "{ loguxPlugin, useSync, ChannelErrors, useFilter, useAuth }"
      },
      "limit": "11.5 KB"
    }
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0"
  }
}
